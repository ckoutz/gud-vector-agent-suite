GVAS_APP_ENV=development
GVAS_LOG_LEVEL=INFO
# Railway injects DATABASE_URL; GVAS_DATABASE_URL overrides it when set.
GVAS_DATABASE_URL=postgresql+asyncpg://postgres:POSTGRES_PASSWORD@postgres:5432/gvas
GVAS_SLACK_SIGNING_SECRET=SLACK_SIGNING_SECRET
GVAS_SLACK_BOT_TOKEN=SLACK_BOT_TOKEN
GVAS_SLACK_EVENTS_PATH=/slack/events
GVAS_SLACK_REQUEST_MAX_AGE_SECONDS=300
GVAS_SLACK_INSTALLATIONS=T0000000000=00000000-0000-0000-0000-000000000000:U0000000000|U0000000001
GVAS_SLACK_API_BASE_URL=https://slack.com/api
GVAS_SLACK_API_TIMEOUT_SECONDS=30
GVAS_SLACK_ATTACHMENT_MAX_BYTES=26214400
GVAS_OPENAI_API_KEY=OPENAI_API_KEY
GVAS_OPENAI_API_BASE_URL=https://api.openai.com/v1
GVAS_OPENAI_TRANSCRIPTION_MODEL=whisper-1
GVAS_OPENAI_TIMEOUT_SECONDS=60
GVAS_OPENAI_MAX_AUDIO_BYTES=26214400
GVAS_RESEND_API_KEY=RESEND_API_KEY
GVAS_RESEND_API_BASE_URL=https://api.resend.com
GVAS_RESEND_FROM_ADDRESS=quotes@example.com
GVAS_RESEND_REPLY_TO_ADDRESS=owner@example.com
GVAS_RESEND_PORTAL_URL=https://gudvector.com/portal/login
GVAS_RESEND_TIMEOUT_SECONDS=30
GVAS_WORKER_BATCH_SIZE=10
GVAS_WORKER_POLL_SECONDS=1
GVAS_WORKER_RETRY_SECONDS=30
GVAS_WORKER_LEASE_SECONDS=300
GVAS_WORKER_ID_PREFIX=outbox-worker
GVAS_BOOTSTRAP_BUSINESS_ID=00000000-0000-0000-0000-000000000000
GVAS_BOOTSTRAP_SLUG=example-business
GVAS_BOOTSTRAP_NAME=Example Business
GVAS_BOOTSTRAP_INDUSTRY=environmental_testing
GVAS_R2_ACCOUNT_ID=R2_ACCOUNT_ID
GVAS_R2_BUCKET=gvas-plan-sets
GVAS_R2_ACCESS_KEY_ID=R2_ACCESS_KEY_ID
GVAS_R2_SECRET_ACCESS_KEY=R2_SECRET_ACCESS_KEY
GVAS_R2_REGION=auto
